
# Console gate. All three must be set or every route returns 401 (fail closed).
# Generate the secret with: openssl rand -base64 32
TRAPLINE_USER=
TRAPLINE_PASSWORD=
TRAPLINE_AUTH_SECRET=

# Set to true ONLY for a public, snapshot-only deployment. Has no effect when the three
# variables above are set, so configuring credentials always wins.
TRAPLINE_PUBLIC=
