NEXT_PUBLIC_API_BASE=/api/v1

# Snapshot-only deployment: the bundled demo data is already sanitised, so the console
# gate is off. Ignored if TRAPLINE_USER/PASSWORD/AUTH_SECRET are set, so a real
# deployment cannot be opened by this line surviving a fork.
#
# This line covers `next build` run locally or in Docker. It does NOT reach Vercel:
# the Vercel CLI excludes .env* from the upload, so a Vercel deployment needs the flag
# as a project environment variable instead:
#   vercel env add TRAPLINE_PUBLIC production   # value: true
# and the gate stays up until the next build after that is set.
TRAPLINE_PUBLIC=true
