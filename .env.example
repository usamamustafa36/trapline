# ── Postgres ─────────────────────────────────────────────
POSTGRES_USER=lure
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trapline
POSTGRES_PORT=5432

# ── Central API ──────────────────────────────────────────
API_PORT=8000
# Used to sign admin JWTs / verify api keys. CHANGE IN PRODUCTION.
SECRET_KEY=generate-a-random-64-char-string
# Fernet key for encrypting per-VPS OTX keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=generate-with-python-c-from-cryptography.fernet-import-Fernet
# Seed demo data (3 VPS + coordinated attackers + threat intel) on first boot.
# Keep FALSE for production — the DB stays empty and fills only from real shipper
# data. Set to true ONLY if you want a local demo dataset.
SEED_ON_START=false
CORS_ORIGINS=http://localhost:3000

# ── Dashboard ────────────────────────────────────────────
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
